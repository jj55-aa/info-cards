<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0f0f0f"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📋 信息卡"
        android:textColor="#ffffff"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="点击刷新"
        android:textColor="#888888"
        android:textSize="10sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card slot 0 -->
        <LinearLayout
            android:id="@+id/card_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1a1a1a"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <View android:id="@+id/card_0_border"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#f0a500" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView android:id="@+id/card_0_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView android:id="@+id/card_0_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#dddddd"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card slot 1 -->
        <LinearLayout
            android:id="@+id/card_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1a1a1a"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <View android:id="@+id/card_1_border"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#f0a500" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView android:id="@+id/card_1_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView android:id="@+id/card_1_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#dddddd"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card slot 2 -->
        <LinearLayout
            android:id="@+id/card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1a1a1a"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <View android:id="@+id/card_2_border"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#f0a500" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView android:id="@+id/card_2_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView android:id="@+id/card_2_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#dddddd"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card slot 3 -->
        <LinearLayout
            android:id="@+id/card_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1a1a1a"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <View android:id="@+id/card_3_border"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#f0a500" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView android:id="@+id/card_3_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView android:id="@+id/card_3_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#dddddd"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card slot 4 -->
        <LinearLayout
            android:id="@+id/card_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1a1a1a"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <View android:id="@+id/card_4_border"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#f0a500" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView android:id="@+id/card_4_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView android:id="@+id/card_4_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#dddddd"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
